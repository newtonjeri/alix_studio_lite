# Lite's own virtual environment (tools/setup_lite.py makes it) and Python caches
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# drop folder for incoming designer files (the kept copies are in docs/reference/)
incoming_ui/

# vs code settings
.vscode
# Lite's logs (server/logbook.py) are committed, so a run on the lab computer reaches every copy;
# to keep them on each computer instead, uncomment:
# Resources/Logs/*
# !Resources/Logs/README.md
# The Lite UI's projects (server/store.py), one folder each, are not committed by Lite; to keep them
# out of `git status`, uncomment:
# Resources/Projects/*
# !Resources/Projects/README.md
