      <inertia ixx="1.87773855311e-06" ixy="-7.19072681283e-13" ixz="8.55727288632e-14" iyy="1.87781912793e-06" iyz="5.11136114965e-14" izz="3.67514764948e-06"/>
    </inertial>
    <visual>
