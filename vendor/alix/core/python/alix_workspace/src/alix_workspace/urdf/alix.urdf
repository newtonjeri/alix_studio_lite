  <!-- ===================================================================== -->
  <!-- VENDOR MANUAL vs THIS MODEL — discrepancies are KNOWN and LEFT AS-IS. -->
  <!--                                                                       -->
  <!-- Authority: docs/Manuals/                                              -->
  <!--   INSPIRE-ROBOTS-THE-DEXTEROUS-HAND-RH56-SERIES-USER-MANUAL.pdf       -->
  <!--   S1.3 (performance parameters) and S2.4.11 (ANGLE_SET, angle defs).  -->
  <!--                                                                       -->
  <!-- The manual agrees with the SHAPE of this model: 12 joints driven by   -->
  <!-- 6 DOF, i.e. one linear actuator per finger driving two joints. That   -->
  <!-- is why six joints here are actuated and six are <mimic> followers.    -->
  <!--                                                                       -->
  <!-- It does NOT give the per-joint split. Its angles are aggregate        -->
  <!-- fingertip measures against the metacarpal plane, and its registers    -->
  <!-- are dimensionless 0-1000 (1000 = open):                               -->
  <!--                                                                       -->
  <!--   four fingers   alpha  19    to 176.7 deg   (157.7 deg span)         -->
  <!--   thumb bending  theta  -13   to  53.6 deg   ( 66.6 deg span)         -->
  <!--   thumb rotation beta    90   to 165   deg   ( 75.0 deg span)         -->
  <!--                                                                       -->
  <!-- So the manual cannot supply the mimic multipliers; the URDF is the    -->
  <!-- only source for those, and alix_hw reads them from here               -->
  <!-- (alix_hw/conversions.hpp, doc/TECHNICAL_INTERFACE.md).                -->
  <!--                                                                       -->
  <!-- Measured against the manual, this model:                              -->
  <!--   index pair (_1 + _2)   175.2 deg  vs  157.7 deg  -> ~17 deg OVER    -->
  <!--   thumb rotation (_1)     71.4 deg  vs   75.0 deg  -> ~4 deg under    -->
  <!--   thumb bending  (_2)     30.0 deg  alone, 64.3 deg with _3 mimic,    -->
  <!--                                     which reconciles with 66.6        -->
  <!--                                                                       -->
  <!-- Left alone deliberately: joint limits are what MoveIt plans against,  -->
  <!-- and every cleaning config was authored against these. Changing them   -->
  <!-- is a re-validation job, not an edit. Recorded here so the next person -->
  <!-- to compare model against manual does not rediscover it.               -->
  <!--                                                                       -->
  <!-- Isaac Sim note: ros/simulation/isaacsim widens ONLY the _2 follower    -->
  <!-- limits, in its own generated URDF, never here. See the _2 joints.     -->
  <!-- ===================================================================== -->
  <joint name="ILH_root_joint" type="fixed">
