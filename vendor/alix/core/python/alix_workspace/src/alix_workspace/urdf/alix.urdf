        <texture filename=""/>
      </material>
    </visual>
    <collision>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <cylinder length="0.025" radius="0.03"/>
      </geometry>
    </collision>
