  <link name="R_ConnectorLink">
    <!-- Mass and inertia derived from connector_link.stl (29.070 cm^3) at 6061
           aluminium density (2700 kg/m^3), 2026-09-06. Replaces a 0.5 kg placeholder
           that implied 17200 kg/m^3 — denser than lead. Same both sides: the adapter
           mesh is shared, and only the collision CYLINDER differs in length (25.0 mm
           right / 22.5 mm left).
           WHY THE CYLINDER IS NOT COUNTED: it overlaps this mesh (cylinder spans
           z[-0.0125,+0.0125], mesh z[0,+0.0202], both declared at origin), so adding
           it would double-count. Visual and collision also disagree about where the
           mesh sits (visual z=0.0125, collision z=0), so the geometry is ambiguous
           and the lighter reading is taken deliberately — see the header note. -->
    <inertial>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.006650738"/>
      <mass value="0.0785"/>
      <inertia ixx="2.05889137343e-05" ixy="0.0" ixz="0.0" iyy="2.05889137343e-05" iyz="0.0" izz="3.72251760405e-05"/>
    </inertial>
    <!-- Extension Link -->
    <!-- Right Extension Link = 25mm, Left Extension Link = 22.5mm -->
    <visual name="">
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <cylinder length="0.025" radius="0.03"/>
      </geometry>
      <material name="">
        <color rgba="1.0 1.0 1.0 1.0"/>
        <texture filename=""/>
      </material>
    </visual>
    <visual name="">
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0125"/>
      <geometry>
        <mesh filename="package://rm_description/meshes/connector_link.dae"/>
      </geometry>
