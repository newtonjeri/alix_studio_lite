    <origin rpy="0 -1.2651 -3.1416" xyz="0.0042331 0 -0.0036843"/>
    <parent link="IRH_right_little_pad"/>
    <child link="IRH_right_little_tip"/>
    <axis xyz="0 0 0"/>
  </joint>
  <!-- ================================================================= -->
  <!-- MIMIC RATIOS: this file is the AUTHORITY for them.                -->
  <!--                                                                   -->
  <!-- alix_hw reads these same multiplier/offset values (see            -->
  <!-- alix_hw/conversions.hpp kMimic*, doc/TECHNICAL_INTERFACE.md), and -->
  <!-- the Isaac Sim path enforces them itself because PhysX drops the   -->
  <!-- coupling. One set of numbers, three consumers.                    -->
  <!--                                                                   -->
  <!-- The RH56 vendor manual (docs/Manuals/) does NOT specify these.    -->
  <!-- It gives only aggregate fingertip angles per DOF, so it cannot    -->
  <!-- be used to check or replace them — the linkage split lives here.  -->
  <!--                                                                   -->
  <!-- Note the finger offset is NEGATIVE: *_2 = 1.1169 * _1 - 0.1865,   -->
  <!-- so at an open hand the follower sits at -0.1865 rad. That is      -->
  <!-- real (alix_hw does not clamp it, and the manual's thumb bending   -->
  <!-- range starts at -13 deg), even though the follower's own          -->
  <!-- lower="0" limit in RH56DFX_*.xacro says otherwise. Known; see the -->
  <!-- note on those joints.                                             -->
  <!-- ================================================================= -->
  <ros2_control name="IRH_inspire_hand_hardware" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="IRH_right_thumb_1_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="IRH_right_thumb_2_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="IRH_right_thumb_3_joint">
      <param name="mimic">IRH_right_thumb_2_joint</param>
      <param name="multiplier">1.1425</param>
      <param name="offset">0</param>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="IRH_right_thumb_4_joint">
      <param name="mimic">IRH_right_thumb_3_joint</param>
      <param name="multiplier">0.7508</param>
      <param name="offset">0.1</param>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="IRH_right_index_1_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="IRH_right_index_2_joint">
      <param name="mimic">IRH_right_index_1_joint</param>
      <param name="multiplier">1.1169</param>
      <param name="offset">-0.1865</param>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="IRH_right_middle_1_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="IRH_right_middle_2_joint">
      <param name="mimic">IRH_right_middle_1_joint</param>
      <param name="multiplier">1.1169</param>
      <param name="offset">-0.1865</param>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="IRH_right_ring_1_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="IRH_right_ring_2_joint">
      <param name="mimic">IRH_right_ring_1_joint</param>
      <param name="multiplier">1.1169</param>
      <param name="offset">-0.1865</param>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="IRH_right_little_1_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="IRH_right_little_2_joint">
      <param name="mimic">IRH_right_little_1_joint</param>
      <param name="multiplier">1.1169</param>
      <param name="offset">-0.1865</param>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
  <!-- camera body, with origin at bottom screw mount -->
  <joint name="camera_joint" type="fixed">
    <origin rpy="0 -1.5707963267948966 -1.5707963267948966" xyz="0.0 0.0625 0.011"/>
    <parent link="R_CameraHolderLink"/>
    <child link="camera_bottom_screw_frame"/>
  </joint>
  <link name="camera_bottom_screw_frame"/>
  <joint name="camera_link_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.010600000000000002 0.0175 0.0125"/>
    <parent link="camera_bottom_screw_frame"/>
    <child link="camera_link"/>
  </joint>
  <link name="camera_link">
    <visual>
      <!-- the mesh origin is at front plate in between the two infrared camera axes -->
      <origin rpy="1.5707963267948966 0 1.5707963267948966" xyz="0.0043 -0.0175 0"/>
      <geometry>
        <mesh filename="package://realsense2_description/meshes/d435.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 -0.0175 0"/>
      <geometry>
        <box size="0.02505 0.09 0.025"/>
      </geometry>
    </collision>
    <!-- INERTIAL REMOVED for the alix robot, 2026-09-06.
           Upstream's own note on these values was that they are "not reliable
           values, and should not be used for modeling", and they are not: for a
           0.072 kg camera the tensor implies a uniform box of 204 x 778 x 204 mm,
           against a real D435 of roughly 90 x 25 x 25 mm.
           On alix the camera sits distal of joint 7, so that tensor entered the
           arm's dynamics and drew an inertia box larger than the whole robot in
           RViz. A link with no inertial, attached by a fixed joint, is treated as
           massless and merged into its parent, which is the right handling here.
           CONSEQUENCE, deliberate: the camera's real 0.072 kg (Intel's own figure)
           is no longer in the model. If arm side mass matters more than the bad
           tensor, fold 0.072 kg into R_CameraHolderLink rather than restoring this.
           NOTE this is a local deviation in a VENDORED package, not tracked by the
           alix repo, so a realsense update will silently revert it. Recorded in
           alix Resource/reports/2026-09-05_arm_emulation_from_telemetry/.
           Original values, kept for reference:
             mass 0.072, ixx 0.003881243, iyy 0.000498940, izz 0.003879257
      -->
  </link>
  <!-- camera depth joints and links -->
  <joint name="camera_depth_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="camera_link"/>
    <child link="camera_depth_frame"/>
  </joint>
  <link name="camera_depth_frame"/>
  <joint name="camera_depth_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="camera_depth_frame"/>
    <child link="camera_depth_optical_frame"/>
  </joint>
  <link name="camera_depth_optical_frame"/>
  <!-- camera left IR joints and links -->
  <joint name="camera_infra1_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0.0 0"/>
    <parent link="camera_link"/>
    <child link="camera_infra1_frame"/>
  </joint>
  <link name="camera_infra1_frame"/>
  <joint name="camera_infra1_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="camera_infra1_frame"/>
    <child link="camera_infra1_optical_frame"/>
  </joint>
  <link name="camera_infra1_optical_frame"/>
  <!-- camera right IR joints and links -->
  <joint name="camera_infra2_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 -0.05 0"/>
    <parent link="camera_link"/>
    <child link="camera_infra2_frame"/>
  </joint>
  <link name="camera_infra2_frame"/>
  <joint name="camera_infra2_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="camera_infra2_frame"/>
    <child link="camera_infra2_optical_frame"/>
  </joint>
  <link name="camera_infra2_optical_frame"/>
  <!-- camera color joints and links -->
  <joint name="camera_color_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0.015 0"/>
    <parent link="camera_link"/>
    <child link="camera_color_frame"/>
  </joint>
  <link name="camera_color_frame"/>
  <joint name="camera_color_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="camera_color_frame"/>
    <child link="camera_color_optical_frame"/>
  </joint>
  <link name="camera_color_optical_frame"/>
  <!-- Reference Frame -->
  <link name="alix_ref_frame"/>
  <joint name="R_reference_frame_joint" type="fixed">
    <parent link="R_Pole"/>
    <child link="alix_ref_frame"/>
    <!-- <origin xyz="0.047 -0.0705 0.035" rpy="0.0 0.0 0.0"/> -->
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.035"/>
  </joint>
  <!-- ================================================================ -->
  <!-- Left Glove frame                                                 -->
  <!-- ================================================================ -->
  <link name="L_glove_frame_1"/>
  <joint name="attach_glove_L_joint" type="fixed">
    <parent link="L_ConnectorLink"/>
    <child link="L_glove_frame_1"/>
    <!-- <origin xyz="-0.04 0.0 0.12" rpy="0.0 0.0 0.0"/> -->
    <origin rpy="0.0 0.0 0.0" xyz="-0.05 0.0 0.145"/>
  </joint>
  <!-- ================================================================ -->
  <!-- Right Glove frame                                                -->
  <!-- ================================================================ -->
  <link name="R_glove_frame_1"/>
  <joint name="attach_glove_R_joint" type="fixed">
    <parent link="R_ConnectorLink"/>
    <child link="R_glove_frame_1"/>
    <!-- <origin xyz="0.04 0.0 0.12" rpy="0.0 0.0 0.0"/> -->
    <origin rpy="0.0 0.0 0.0" xyz="0.05 0.0 0.145"/>
  </joint>
  <!-- ================================================================ -->
  <!-- Left Glove frame 2                                               -->
  <!-- ================================================================ -->
  <link name="L_glove_frame_2"/>
  <joint name="attach_glove_L_2_joint" type="fixed">
    <parent link="L_ConnectorLink"/>
    <child link="L_glove_frame_2"/>
    <!-- <origin xyz="-0.02 0.0 0.15" rpy="0.0 0.0 0.0"/> -->
    <origin rpy="0.0 0.0 0.0" xyz="-0.0135 0.0 0.165"/>
  </joint>
  <!-- ================================================================ -->
  <!-- Right Glove frame 2                                              -->
  <!-- ================================================================ -->
  <link name="R_glove_frame_2"/>
  <joint name="attach_glove_R_2_joint" type="fixed">
    <parent link="R_ConnectorLink"/>
    <child link="R_glove_frame_2"/>
    <!-- <origin xyz="0.02 0.0 0.15" rpy="0.0 0.0 0.0"/> -->
    <origin rpy="0.0 0.0 0.0" xyz="0.0135 0.0 0.165"/>
  </joint>
  <!-- ================================================================ -->
  <!-- Right Glove frame 3 — aligned to IRH_right_middle_tip            -->
  <!-- ================================================================ -->
  <link name="R_glove_frame_3"/>
  <joint name="attach_glove_R_3_joint" type="fixed">
    <parent link="R_ConnectorLink"/>
    <child link="R_glove_frame_3"/>
    <!-- Transform from R_ConnectorLink to IRH_right_middle_tip (via tf2_echo) -->
    <!-- <origin xyz="0.073 0.007 0.164" rpy="-3.142 0.971 -3.142"/> -->
    <origin rpy="0.0 0.0 0.0" xyz="0.075 0.007 0.17"/>
  </joint>
  <!-- ================================================================ -->
  <!-- Left Glove frame 3 — aligned to ILH_left_middle_tip              -->
  <!-- ================================================================ -->
  <link name="L_glove_frame_3"/>
  <joint name="attach_glove_L_3_joint" type="fixed">
    <parent link="L_ConnectorLink"/>
    <child link="L_glove_frame_3"/>
    <!-- Transform from L_ConnectorLink to ILH_left_middle_tip (via tf2_echo) -->
    <origin rpy="0.0 0.0 0.0" xyz="-0.075 0.007 0.17"/>
  </joint>
  <!-- ================================================================ -->
  <!-- Left Tip Frame                                                   -->
  <!-- ================================================================ -->
  <link name="L_tip_frame"/>
  <joint name="attach_tip_joint" type="fixed">
    <parent link="L_ConnectorLink"/>
    <child link="L_tip_frame"/>
    <origin rpy="0.0 0.0 0.0" xyz="-0.015 0.005 0.23"/>
  </joint>
  <!-- ================================================================ -->
  <!-- Right Tip Frame                                                  -->
  <!-- ================================================================ -->
  <link name="R_tip_frame"/>
  <joint name="attach_tip_R_joint" type="fixed">
    <parent link="R_ConnectorLink"/>
    <child link="R_tip_frame"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.015 0.005 0.23"/>
  </joint>
  <!-- Glove Frame 4 -->
  <!-- Left -->
  <link name="L_glove_frame_4"/>
  <joint name="attach_glove_L_4_joint" type="fixed">
    <parent link="L_ConnectorLink"/>
    <child link="L_glove_frame_4"/>
    <origin rpy="0.0 0.0 0.0" xyz="-0.055 0.007 0.205"/>
  </joint>
  <!-- Right -->
  <link name="R_glove_frame_4"/>
  <joint name="attach_glove_R_4_joint" type="fixed">
    <parent link="R_ConnectorLink"/>
    <child link="R_glove_frame_4"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.055 0.007 0.205"/>
  </joint>
  <!-- ================================================================ -->
  <!-- Index fingertip frames (flush press) — FIXED frames at the tip   -->
  <!-- of the FULLY-OPENED index finger (index_1 = 0.01, index_2 hard-  -->
  <!-- stopped at 0), orientation = the connector link (rpy 0 0 0).     -->
  <!-- A fixed frame keeps the finger joints OUT of the planning group: -->
  <!-- an arm+index chain emits 8-joint trajectories that the hardware  -->
  <!-- controllers reject (arm: joint-set mismatch; hand: partial goal).-->
  <!-- Offsets = FK of *_index_tip in the connector frame at full-open. -->
  <!-- ================================================================ -->
  <link name="L_index_tip_frame"/>
  <joint name="attach_index_tip_L_joint" type="fixed">
    <parent link="L_ConnectorLink"/>
    <child link="L_index_tip_frame"/>
    <origin rpy="0.0 0.0 0.0" xyz="-0.0242 0.0288 0.225"/>
  </joint>
  <link name="R_index_tip_frame"/>
  <joint name="attach_index_tip_R_joint" type="fixed">
    <parent link="R_ConnectorLink"/>
    <child link="R_index_tip_frame"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.0242 0.0288 0.225"/>
  </joint>
  <!-- include_arm_unit -->
</robot>
