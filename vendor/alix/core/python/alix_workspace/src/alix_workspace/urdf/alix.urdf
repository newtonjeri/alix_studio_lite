<robot name="alix">
  <!--
        Gazebo simulation: JointPositionController plugins for bin_rail_joint and
        bin_drop_joint.  These subscribe to Float64 cmd_pos topics bridged from ROS
        via ros_gz_bridge (see butterfli_description/config/gz_bridge.yaml).
        bin_state_publisher publishes to these topics on every 50 Hz tick so Gazebo
        stays in sync with the discrete state machine.

        Gain values are tuned for the simulated low-mass prismatic joints.
        Adjust p_gain if the joints overshoot or oscillate in Gazebo.
    -->
  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>bin_rail_joint</joint_name>
      <topic>/bin_rail_joint/cmd_pos</topic>
      <p_gain>4000.0</p_gain>
      <i_gain>400.0</i_gain>
      <d_gain>60.0</d_gain>
      <i_max>200</i_max>
      <i_min>-200</i_min>
      <cmd_max>500</cmd_max>
      <cmd_min>-500</cmd_min>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>bin_drop_joint</joint_name>
      <topic>/bin_drop_joint/cmd_pos</topic>
      <p_gain>4000.0</p_gain>
      <i_gain>400.0</i_gain>
      <d_gain>60.0</d_gain>
      <i_max>200</i_max>
      <i_min>-200</i_min>
      <cmd_max>500</cmd_max>
      <cmd_min>-500</cmd_min>
    </plugin>
  </gazebo>
  <!--
        ACTUAL simulated positions of the two bin joints, for the simulated
        limit switches (bin_switch_emulator) to sense. This is the output of
        physics — it lags the command and stops short if the joint is
        obstructed — which is what makes the emulated switches a real
        measurement rather than the state machine confirming itself.

        Published on its OWN topic, NOT /joint_states: bin_state_publisher is
        the sole publisher of bin_rail_joint / bin_drop_joint there, and a
        second publisher would fight it (last message wins), so the two would
        silently overwrite each other.
    -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/bin_joint_states_sim</topic>
      <joint_name>bin_rail_joint</joint_name>
      <joint_name>bin_drop_joint</joint_name>
    </plugin>
  </gazebo>
  <!--
        Gazebo simulation: JointPositionController plugin for
        glove_wearing_unit_arm_joint.  Subscribes to the Float64 cmd_pos topic
        bridged from ROS via ros_gz_bridge (see butterfli_description/config/
        gz_bridge.yaml).  glove_state_publisher publishes to this topic on every
        50 Hz tick so Gazebo stays in sync with the discrete state machine.
        Same pattern as the bin joints in bin.xacro.
    -->
  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>glove_wearing_unit_arm_joint</joint_name>
      <topic>/glove_wearing_unit_arm_joint/cmd_pos</topic>
      <p_gain>200.0</p_gain>
      <i_gain>10.0</i_gain>
      <d_gain>5.0</d_gain>
      <i_max>50</i_max>
      <i_min>-50</i_min>
      <cmd_max>500</cmd_max>
      <cmd_min>-500</cmd_min>
    </plugin>
  </gazebo>
  <!-- Pole macro to handle both right and left poles -->
  <material name="aluminum">
    <color rgba="0.5 0.5 0.5 1"/>
  </material>
  <material name="plastic">
    <color rgba="0.1 0.1 0.1 1"/>
  </material>
  <!-- MONOCULAR CAMERA -->
  <gazebo reference="camera_color_frame">
    <sensor name="camera" type="camera">
      <gz_frame_id>camera_color_frame</gz_frame_id>
      <optical_frame_id>camera_color_optical_frame</optical_frame_id>
      <camera>
        <horizontal_fov>1.085595</horizontal_fov>
        <image>
          <width>1920</width>
          <height>1080</height>
          <format>RGB_INT8</format>
        </image>
        <camera_info_topic>/camera/camera/color/camera_info</camera_info_topic>
        <clip>
          <near>0.1</near>
          <far>10</far>
        </clip>
        <distortion>
          <k1>0.096559</k1>
          <k2>-0.237840</k2>
          <k3>0.113659</k3>
          <p1>0.000396</p1>
          <p2>0.000247</p2>
          <center>0.5 0.5</center>
        </distortion>
      </camera>
      <always_on>1</always_on>
      <update_rate>10</update_rate>
      <visualize>false</visualize>
      <topic>/camera/camera/color/image_raw</topic>
      <enable_metrics>true</enable_metrics>
    </sensor>
  </gazebo>
  <!-- DEPTH CAMERA -->
  <gazebo reference="camera_depth_frame">
    <sensor name="rgbd_camera" type="rgbd_camera">
      <gz_frame_id>camera_depth_frame</gz_frame_id>
      <optical_frame_id>camera_depth_optical_frame</optical_frame_id>
      <camera name="realsense_d435_depth_camera">
        <horizontal_fov>1.3962634</horizontal_fov>
        <lens>
          <intrinsics>
            <fx>277.1</fx>
            <fy>277.1</fy>
            <cx>160.5</cx>
            <cy>120.5</cy>
            <s>0</s>
          </intrinsics>
        </lens>
        <distortion>
          <k1>0.104207</k1>
          <k2>-0.255558</k2>
          <k3>0.128694</k3>
          <p1>0.000512</p1>
          <p2>0.000319</p2>
          <center>0.5 0.5</center>
        </distortion>
        <image>
          <width>1280</width>
          <height>720</height>
          <format>L8</format>
        </image>
        <clip>
          <near>0.01</near>
          <far>300</far>
        </clip>
        <depth_camera>
          <clip>
            <near>0.1</near>
            <far>10</far>
          </clip>
        </depth_camera>
        <noise>
          <type>gaussian</type>
          <mean>0</mean>
          <stddev>0.003</stddev>
        </noise>
      </camera>
      <always_on>1</always_on>
      <update_rate>10</update_rate>
      <visualize>0</visualize>
      <topic>/camera/camera/depth</topic>
    </sensor>
  </gazebo>
  <!-- <link name="world" />
    <xacro:sensor_d435 parent="world" use_nominal_extrinsics="$(arg use_nominal_extrinsics)" add_plug="$(arg add_plug)" use_mesh="$(arg use_mesh)">
        <origin xyz="0 0 1.0" rpy="0 0 0"/>
    </xacro:sensor_d435> -->
  <!-- Base link -->
  <link name="base_link"/>
  <!-- UGV body base_link joint -->
  <joint name="UGV_body_joint" type="fixed">
    <parent link="base_link"/>
    <child link="UGV_body"/>
    <!-- <origin xyz="0.0 0.0 0.225" rpy="0.0 0.0 0.0"/> -->
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.195"/>
  </joint>
  <!-- Fixed mount: L-rail bolted to UGV body -->
  <joint name="bin_mount_joint" type="fixed">
    <parent link="UGV_body"/>
    <child link="bin_rail_link"/>
    <origin rpy="0 0 0" xyz="0.0 0.0 0.294"/>
  </joint>
  <!-- Rail structure (L-shaped, fixed geometry) -->
  <link name="bin_rail_link">
    <visual>
      <origin rpy="1.5707963267948966 0.0 0.0" xyz="0.12 0.0 0.0"/>
      <geometry>
        <mesh filename="package://ugv_description/meshes/visuals/BinRail.obj" scale="1.0 1.0 1.0"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0.0 0.0 0.0" xyz="0.12 0.0 0.0"/>
      <geometry>
        <mesh filename="package://ugv_description/meshes/collision/BinRail.stl" scale="1.0 1.0 1.0"/>
      </geometry>
    </collision>
    <inertial>
      <!-- Mass from geometry, 2026-09-06. Was 2.0 kg over a 41.3 cm^3 mesh, i.e.
                     48465 kg/m^3: impossible in any material (solid steel would be
                     0.324 kg). The mesh is a thin bracket, 4.1 percent of its own
                     bounding box, so the volume is real material here. 41.27 cm^3 at
                     2700 kg/m^3 (aluminium extrusion) gives 0.1114 kg. Tensor computed
                     from the same mesh at that mass and carried into link axes through
                     the collision origin offset of x=0.12. Newton approved the drop.
                -->
      <origin rpy="-0.00484656606979 0.000227127381644 -1.54328700143" xyz="0.118351869 -0.000398801137 0.022376369"/>
      <mass value="0.1114"/>
      <inertia ixx="0.000493351094279" ixy="0.0" ixz="0.0" iyy="0.00175662705281" iyz="0.0" izz="0.00224050323591"/>
    </inertial>
  </link>
  <!-- Stage 1: slide carriage out in +X (limits from peripheral_joints.yaml) -->
  <joint name="bin_rail_joint" type="prismatic">
    <parent link="bin_rail_link"/>
    <child link="bin_carriage_link"/>
    <axis xyz="1 0 0"/>
    <limit effort="100.0" lower="0.0" upper="0.2" velocity="0.2"/>
    <origin rpy="0 0 0" xyz="0.06 0.0 0.0"/>
    <dynamics damping="0.5" friction="10.0"/>
  </joint>
  <!-- Carriage frame (intermediate, no visual — pure kinematic frame) -->
  <link name="bin_carriage_link">
    <inertial>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>
  <!-- Stage 2: lower bin in -Z (limits from peripheral_joints.yaml) -->
  <!-- Note: bin origin relative to rail origin = 0,0,0 (same origin) -->
  <joint name="bin_drop_joint" type="prismatic">
    <parent link="bin_carriage_link"/>
    <child link="bin_link"/>
    <axis xyz="0 0 -1"/>
    <limit effort="100.0" lower="0.0" upper="0.45" velocity="0.2"/>
    <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
    <dynamics damping="0.5" friction="10.0"/>
  </joint>
  <!-- ==================================================================
             SUPERSEDED 2026-08-29 by the bin_link immediately below. Kept,
             not deleted, per standing practice.

             This is the ORIGINAL full height bin: collision body 406 mm tall,
             meshes Bin.obj / Bin.stl (both still on disk, untouched). The
             replacement carries the 40 mm shorter BinShort meshes and has
             byte identical origins, so reverting is a matter of swapping
             which of the two blocks is commented out.

             The Bin.stl hollow shell note below sat inside <collision>. XML
             comments cannot nest, so its own delimiters have been stripped to
             let this outer comment close; its text is otherwise verbatim and
             still describes Bin.stl accurately.

        Bin (movable peripheral)
        <link name="bin_link">
            <visual>
                <origin xyz="0.0 0.0 0.0" rpy="${pi/2} 0.0 0.0"/>
                <geometry>
                    <mesh filename="package://ugv_description/meshes/visuals/Bin.obj"
                          scale="1.0 1.0 1.0"/>
                </geometry>
            </visual>
            <collision>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <geometry>
                    <mesh filename="package://ugv_description/meshes/collision/Bin.stl"
                          scale="1.0 1.0 1.0"/>
                </geometry>
                Bin.stl is a HOLLOW BOX-SHELL approximation (2026-08-14):
                     5 watertight slabs (floor + 4 walls, 6 mm), outer envelope
                     x [-0.017..+0.172], y [-0.227..+0.226], z [+0.016..+0.422]
                     matching the real tub. Interior cavity is open so objects
                     can be dropped in. The two bail handles are SEPARATE fixed
                     links (bin_handle_left/right) so collision can be toggled
                     per-handle during bin-carry grasps.
            </collision>
            <inertial>
                <origin xyz="0.0774999899005 -0.000600002706051 0.141536373828" rpy="-1.57079639802 -3.33066907388e-16 1.57079632679"/>
                <mass value="1.5"/>
                <inertia ixx="0.0296729265048" ixy="0.0" ixz="0.0" iyy="0.0431742305288" iyz="0.0" izz="0.056242314372"/>
            </inertial>
        </link>
             ================================================================== -->
  <!-- Bin (movable peripheral) — 40 mm shorter body, 2026-08-29.
             Supersedes the block above. Origins are UNCHANGED so this drops into
             the complete alix unit with no other edit; only the meshes differ.
             Generated by tools/meshes/shorten_bin_mesh.py (band compression, logo
             preserved). Body height 406 mm to 366 mm; the compressed band is
             y 0.0880..0.1769 in Bin.obj, plain tub wall carrying no artwork. -->
  <link name="bin_link">
    <visual>
      <origin rpy="1.5707963267948966 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="package://ugv_description/meshes/visuals/BinShort.obj" scale="1.0 1.0 1.0"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="package://ugv_description/meshes/collision/BinShort.stl" scale="1.0 1.0 1.0"/>
      </geometry>
      <!-- BinShort.stl is Bin.stl shortened by 40 mm: same hollow box
                     shell, same 60 facets, still watertight and winding
                     consistent. Outer envelope x [-0.017..+0.172],
                     y [-0.227..+0.226], z [+0.016..+0.382]. The tub has only
                     four distinct z levels, none inside the compressed band, so
                     the walls are shortened by an exact rigid shift with no
                     distortion. Interior cavity still open; the two bail handles
                     are still SEPARATE fixed links (bin_handle_left/right). -->
    </collision>
    <inertial>
      <origin rpy="-1.57079639802 -3.33066907388e-16 1.57079632679" xyz="0.0774999899005 -0.000600002706051 0.141536373828"/>
      <mass value="1.5"/>
      <inertia ixx="0.0296729265048" ixy="0.0" ixz="0.0" iyy="0.0431742305288" iyz="0.0" izz="0.056242314372"/>
    </inertial>
  </link>
  <!-- Bail handles as separate fixed links: fingers grip these during
             bin carry; keeping them as own links lets allow/forbid_collision
             target the handles alone (see cleaning_tasks contact_links.yaml,
             contact_surface_objects.bin_link). Geometry extracted from the
             visual's handle submesh, watertight remeshed (~400 tris each). -->
  <joint name="bin_handle_left_joint" type="fixed">
    <parent link="bin_link"/>
    <child link="bin_handle_left"/>
    <!-- 40 mm down: rides the shortened bin body (2026-08-29).
                 Its own geometry bakes the rim height in, so without this
                 offset it would hover where the old 406 mm rim used to be.
                 MUST stay equal to REDUCTION_M in tools/meshes/shorten_bin_mesh.py.
                 Superseded: <origin xyz="0 0 0" rpy="0 0 0"/> -->
    <origin rpy="0 0 0" xyz="0 0 -0.04"/>
  </joint>
  <link name="bin_handle_left">
    <collision>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="package://ugv_description/meshes/collision/bin_handle_left.stl" scale="1.0 1.0 1.0"/>
      </geometry>
    </collision>
    <inertial>
      <!-- Mass from geometry, 2026-09-06: 5.5 cm^3 at 7850 kg/m^3 (steel).
                     Was 0.05 kg, i.e. ~9040 kg/m^3, above steel. Tensor recomputed
                     from the same collision mesh at the new mass, and the COM is the
                     mesh's own centroid rather than the rounded value it replaced.
                -->
      <origin rpy="1.57015989327 -0.00428564313571 0.000219907080402" xyz="0.0679764177 0.207031705 0.423324944"/>
      <mass value="0.0435"/>
      <inertia ixx="1.1569696973e-05" ixy="0.0" ixz="0.0" iyy="7.22860706521e-05" iyz="0.0" izz="8.36497696749e-05"/>
    </inertial>
  </link>
  <joint name="bin_handle_right_joint" type="fixed">
    <parent link="bin_link"/>
    <child link="bin_handle_right"/>
    <!-- 40 mm down: rides the shortened bin body (2026-08-29).
                 Its own geometry bakes the rim height in, so without this
                 offset it would hover where the old 406 mm rim used to be.
                 MUST stay equal to REDUCTION_M in tools/meshes/shorten_bin_mesh.py.
                 Superseded: <origin xyz="0 0 0" rpy="0 0 0"/> -->
    <origin rpy="0 0 0" xyz="0 0 -0.04"/>
  </joint>
  <link name="bin_handle_right">
    <collision>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="package://ugv_description/meshes/collision/bin_handle_right.stl" scale="1.0 1.0 1.0"/>
