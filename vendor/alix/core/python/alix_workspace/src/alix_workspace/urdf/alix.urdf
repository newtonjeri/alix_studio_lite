  </joint>
  <link name="R_Link2">
    <inertial>
      <origin rpy="-3.06632254142 -1.35570425849 -1.56797818587" xyz="-0.0003570254626 0.005329005546 0.1067980297"/>
      <mass value="1.217"/>
      <inertia ixx="0.00076506747345" ixy="0.0" ixz="0.0" iyy="0.00348828141093" iyz="0.0" izz="0.00356685628412"/>
    </inertial>
    <visual>
