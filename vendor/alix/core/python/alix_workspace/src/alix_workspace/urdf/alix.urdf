    <limit acceleration="10.471975" effort="60" lower="-2.2689280275926285" upper="2.2689280275926285" velocity="3.141592653589793"/>
    <dynamics damping="0.5" friction="1.0"/>
  </joint>
  <link name="R_Link3">
    <inertial>
      <origin rpy="1.57695455281 0.0844756383402 -1.56509770421" xyz="2.972972835e-06 0.01132396362 -0.01039801756"/>
      <mass value="1.11"/>
      <inertia ixx="0.00105941409861" ixy="0.0" ixz="0.0" iyy="0.00150200058858" iyz="0.0" izz="0.00183668623981"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://rm_description/meshes/rm_75_arm/link3.STL"/>
