    <inertial>
      <origin rpy="3.13891981569 -1.30139539826 -3.13957047809" xyz="0.00239343363 -6.64836353e-06 -0.0129843556"/>
      <mass value="0.000948631"/>
      <inertia ixx="2.31274142971e-08" ixy="0.0" ixz="0.0" iyy="7.71003009345e-08" iyz="0.0" izz="8.15544474508e-08"/>
