             The manual backs the negative side — thumb bending reaches -13
             deg — so the LIMIT is the wrong half, not the offset. Left as-is;
             the Isaac path widens it in its generated URDF only. -->
    <limit effort="1" lower="0" upper="1.527" velocity="2"/>
    <mimic joint="IRH_right_index_1_joint" multiplier="1.1169" offset="-0.1865"/>
