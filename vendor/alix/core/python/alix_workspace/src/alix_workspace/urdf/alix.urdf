    </collision>
  </link>
  <!-- arm - base joint -->
  <joint name="glove_wearing_unit_arm_joint" type="revolute">
    <parent link="glove_wearing_unit_base"/>
    <child link="glove_wearing_unit_arm"/>
    <origin rpy="0 0 0" xyz="0.105 0.011 0.0845"/>
    <axis xyz="0 -1 0"/>
    <limit effort="100" lower="0.0" upper="1.57" velocity="1.0"/>
    <dynamics damping="0.5" friction="1.0"/>
  </joint>
  <!-- Glove Wearing Unit Arm -->
  <link name="glove_wearing_unit_arm">
    <!-- inertia -->
    <inertial>
      <!-- Inertia from geometry, 2026-09-06. The tensor was an ISOTROPIC
                 placeholder with the COM at the origin, which describes no real
                 body. Recomputed from this link's own collision mesh
                 (glove_wearing_lever_arm.stl) at the SAME mass, by tetrahedron
                 decomposition, with the mesh's own centroid as the COM.
                 MASS IS UNCHANGED and is not derived from density: the mesh is a
                 watertight remesh that encloses cavities, so its volume is
                 ENCLOSED volume, not material. For a skeletal frame the existing
                 figure is plausible and density would badly overestimate it.
            -->
      <mass value="0.3"/>
      <origin rpy="-0.113742636727 0.000328901948837 1.57477611743" xyz="0.146567801 -0.0116211675 0.0178158503"/>
      <inertia ixx="0.00132732776496" ixy="0.0" ixz="0.0" iyy="0.00321583551782" iyz="0.0" izz="0.00445485917722"/>
    </inertial>
    <!-- visual -->
    <visual>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://ugv_description/meshes/visuals/glove_wearing_lever_arm.obj"/>
      </geometry>
    </visual>
    <!-- collision -->
    <collision>
      <geometry>
        <mesh filename="package://ugv_description/meshes/collision/glove_wearing_lever_arm.stl"/>
      </geometry>
    </collision>
  </link>
  <!-- <xacro:glove_wearing_unit_macro parent_link="UGV_body"
                                       origin_xyz="-0.220 0.0 0.917"
                                       origin_rpy="0 0 0"/> -->
  <!-- UGV body -->
  <link name="UGV_body">
    <visual>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="package://ugv_description/meshes/visuals/body.dae" scale="1.0 1.0 1.0"/>
      </geometry>
    </visual>
    <visual>
      <origin rpy="1.5707963267948966 0.0 0.0" xyz="0.0 0.0 0.296"/>
      <geometry>
        <mesh filename="package://ugv_description/meshes/visuals/ugv_cover.obj" scale="1.0 1.0 1.0"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0.0 0.0 3.141592653589793" xyz="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="package://ugv_description/meshes/collision/body.stl" scale="1.0 1.0 1.0"/>
      </geometry>
    </collision>
    <collision>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.296"/>
      <geometry>
        <mesh filename="package://ugv_description/meshes/collision/ugv_cover.stl" scale="1.0 1.0 1.0"/>
      </geometry>
    </collision>
    <inertial>
      <!-- MASS AND COM SET BY NEWTON, 2026-09-06.
                     90 kg is the real chassis figure, and the COM is placed at this
                     link's ORIGIN as instructed.

                     HISTORY, so the reversal is not mistaken for a regression: the
                     COM sat at z=0.0975 below the origin, lowered 2026-08-31 because
                     with it at the origin the static tip margins measured only
                     12.6 deg folded / 7.4 deg at dual_arms_zero_pose (F102). That
                     was a compensation for excess mass at the ARM ENDS, which has
                     since been removed at source: the tool side went from 1.641 kg
                     to 0.79 kg per arm when the ConnectorLink / CameraHolderLink
                     0.5 kg placeholders were corrected, and the D435 inertia was
                     dropped. With the real cause fixed, the UGV mass is placed
                     honestly rather than fudged low.
                     Effect, measured: robot COM rises 43.4 mm (260.3 to 303.7 mm)
                     and the robot gains 20 kg.

                     TENSOR. Composite of this link's TWO collision meshes, body.stl
                     (at rpy 0 0 pi) and ugv_cover.stl (at z=0.296), each carried
                     into link axes and combined by parallel axis. Mass is split
                     between them by volume, 37.72 + 52.28 kg, i.e. a uniform shell
                     density. The shape's own centroid is (62.7, 0.2, 447.6) mm; the
                     tensor is its rotational inertia about that centroid, declared
                     with the COM at the origin per the instruction above.
                     Radius of gyration 375.9 mm against a 507 mm half diagonal, so
                     physically legal. NOTE the shell mesh cannot give the mass:
                     8.4 litres of shell at steel density is 66 kg, and the real
                     90 kg includes batteries, motors and electronics that no mesh
                     here represents. That is why the mass is an input, not derived.
                -->
      <origin rpy="-0.385653719609 1.24959429042 0.0119604379089" xyz="-0.0128679983602 0.000749515013186 0.212153280468"/>
      <mass value="90.0"/>
      <inertia ixx="3.90147497702" ixy="0.0" ixz="0.0" iyy="5.79849715796" iyz="0.0" izz="5.8161362495"/>
    </inertial>
  </link>
