  <!-- d7 NOTE — deliberately NOT changed. joint7 (0.114) + the 0.05 camera
         holder puts joint 6 -> flange at 0.164 m; ROBOT_MODEL.md 6 measures the
         RM75-6FB at 0.1612 m, so this description is 2.8 mm long at the flange
         and will show up as a constant offset along the tool axis between what
         ROS plans and what the controller executes.

         Left alone on purpose. Correcting it here moves forward kinematics away
         from `alix_workspace/urdf/alix.urdf` — the description that ran 13/13
         hardware tasks — and test_kinematic_gate measures exactly that
         (worst |dT| = 2.798e-03 m when it was tried). ROBOT_MODEL.md says
         "reconcile it to 0.1612 BEFORE the bridge relies on either", and
         reconciling means agreeing with the CONTROLLER, which needs the arms.
         Newton's brief was "kinematics mostly correct" — inertia, speeds and
         joint ranges. This one is his call, with hardware present. -->
  <joint name="R_joint7" type="revolute">
    <origin rpy="0.0 0.0 1.5707963267948966" xyz="0.0 0.0 0.114"/>
    <parent link="R_Link6"/>
    <child link="R_CameraHolderLink"/>
    <axis xyz="0 0 1"/>
    <limit acceleration="10.471975" effort="10" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.9269908169872414"/>
    <dynamics damping="0.5" friction="1.0"/>
  </joint>
