  <ros2_control name="UGV_hardware" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <!-- Suspension Joints (Steering) -->
    <joint name="UGV_front_left_suspension_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="UGV_front_right_suspension_joint">
      <command_interface name="position"/>
      <state_interface name="position">
