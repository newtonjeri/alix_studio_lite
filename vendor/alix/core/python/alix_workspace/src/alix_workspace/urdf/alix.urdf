                     Was 0.05 kg, i.e. ~9040 kg/m^3, above steel. Tensor recomputed
                     from the same collision mesh at the new mass, and the COM is the
                     mesh's own centroid rather than the rounded value it replaced.
                -->
      <origin rpy="1.5709474295 -0.00293367949266 3.85812261669e-05" xyz="0.0686450638 -0.207984598 0.423523037"/>
      <mass value="0.0433"/>
      <inertia ixx="1.13713836576e-05" ixy="0.0" ixz="0.0" iyy="7.21089693802e-05" iyz="0.0" izz="8.32718452623e-05"/>
    </inertial>
  </link>
  <!-- Top covers with a central glove-drop slot (2026-08-14):
             each spans 1/2.25 of the bin x-width from its wall, leaving a
