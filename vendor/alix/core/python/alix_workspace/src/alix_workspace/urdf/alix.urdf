      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <!-- Wheel Joints (Driving) -->
    <joint name="UGV_front_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="UGV_front_right_wheel_joint">
