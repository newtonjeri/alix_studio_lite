  <!-- ================================================================= -->
  <!-- MIMIC RATIOS: this file is the AUTHORITY for them.                -->
  <!--                                                                   -->
  <!-- alix_hw reads these same multiplier/offset values (see            -->
  <!-- alix_hw/conversions.hpp kMimic*, doc/TECHNICAL_INTERFACE.md), and -->
  <!-- the Isaac Sim path enforces them itself because PhysX drops the   -->
  <!-- coupling. One set of numbers, three consumers.                    -->
  <!--                                                                   -->
  <!-- The RH56 vendor manual (docs/Manuals/) does NOT specify these.    -->
  <!-- It gives only aggregate fingertip angles per DOF, so it cannot    -->
  <!-- be used to check or replace them — the linkage split lives here.  -->
  <!--                                                                   -->
  <!-- Note the finger offset is NEGATIVE: *_2 = 1.1169 * _1 - 0.1865,   -->
  <!-- so at an open hand the follower sits at -0.1865 rad. That is      -->
  <!-- real (alix_hw does not clamp it, and the manual's thumb bending   -->
  <!-- range starts at -13 deg), even though the follower's own          -->
  <!-- lower="0" limit in RH56DFX_*.xacro says otherwise. Known; see the -->
  <!-- note on those joints.                                             -->
  <!-- ================================================================= -->
  <ros2_control name="ILH_inspire_hand_hardware" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="ILH_left_thumb_1_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="ILH_left_thumb_2_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="ILH_left_thumb_3_joint">
      <param name="mimic">ILH_left_thumb_2_joint</param>
      <param name="multiplier">1.1425</param>
      <param name="offset">0</param>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="ILH_left_thumb_4_joint">
      <param name="mimic">ILH_left_thumb_3_joint</param>
      <param name="multiplier">0.7508</param>
      <param name="offset">0.1</param>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="ILH_left_index_1_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="ILH_left_index_2_joint">
      <param name="mimic">ILH_left_index_1_joint</param>
      <param name="multiplier">1.1169</param>
      <param name="offset">-0.1865</param>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="ILH_left_middle_1_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="ILH_left_middle_2_joint">
      <param name="mimic">ILH_left_middle_1_joint</param>
      <param name="multiplier">1.1169</param>
      <param name="offset">-0.1865</param>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="ILH_left_ring_1_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="ILH_left_ring_2_joint">
      <param name="mimic">ILH_left_ring_1_joint</param>
      <param name="multiplier">1.1169</param>
      <param name="offset">-0.1865</param>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="ILH_left_little_1_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="ILH_left_little_2_joint">
      <param name="mimic">ILH_left_little_1_joint</param>
      <param name="multiplier">1.1169</param>
      <param name="offset">-0.1865</param>
