  <!-- Glove Wearing Unit -->
  <!-- joint to parent -->
  <joint name="glove_wearing_unit_joint" type="fixed">
    <origin rpy="0 0.1309 0" xyz="-0.20 0.0 0.982"/>
    <parent link="UGV_body"/>
    <child link="glove_wearing_unit_base"/>
  </joint>
  <!-- link -->
  <link name="glove_wearing_unit_base">
    <!-- inertia -->
    <inertial>
      <!-- Inertia from geometry, 2026-09-06. The tensor was an ISOTROPIC
                 placeholder with the COM at the origin, which describes no real
                 body. Recomputed from this link's own collision mesh
                 (glove_wearing_unit.stl) at the SAME mass, by tetrahedron
                 decomposition, with the mesh's own centroid as the COM.
                 MASS IS UNCHANGED and is not derived from density: the mesh is a
                 watertight remesh that encloses cavities, so its volume is
                 ENCLOSED volume, not material. For a skeletal frame the existing
                 figure is plausible and density would badly overestimate it.
            -->
      <mass value="2.0"/>
      <origin rpy="3.11735978152 -3.27088829582e-05 -1.54143088448" xyz="0.126269245 -0.00114685875 0.0390648069"/>
      <inertia ixx="0.0293925656512" ixy="0.0" ixz="0.0" iyy="0.0367139668542" iyz="0.0" izz="0.0616317538946"/>
    </inertial>
    <!-- visual -->
    <visual>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://ugv_description/meshes/visuals/glove_wearing_unit.obj"/>
